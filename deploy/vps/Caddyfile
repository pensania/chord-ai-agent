{$DOMAIN} {
	encode gzip

	# Only the routes Chord, Paystack and staff need are public. Everything else is a 404.
	# /admin has its own login; drop it from this list to keep the portal off the internet.
	@public path /mcp /webhooks/paystack /healthz /admin /admin/*
	handle @public {
		reverse_proxy app:8080
	}
	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format json
	}
}
