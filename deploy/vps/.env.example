# Public hostname that points at this VPS (an A record).
# No domain? Use your IP with sslip.io, e.g. 203.0.113.10 -> 203-0-113-10.sslip.io
DOMAIN=checkout.example.com

# Generate with: openssl rand -hex 32   (paste the same value into Chord as the MCP bearer token)
MCP_BEARER_TOKEN=
# Paystack TEST secret key (sk_test_...). Live keys are refused.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

STORE=memory
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

CHORD_EVENT_WEBHOOK_URL=
CHORD_EVENT_SIGNING_SECRET=

# Admin portal at https://$DOMAIN/admin. Unset = off. At least 10 characters.
ADMIN_PASSWORD=
# Optional staff PINs that survive restarts, e.g. kemi:1234,musa:4321 (ids from data/staff.json)
STAFF_PINS=
