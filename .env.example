# Server
PORT=8080
# Shared secret Chord sends as "Authorization: Bearer <token>" (MCP server auth_type=bearer)
MCP_BEARER_TOKEN=change-me-long-random-string

# Paystack TEST mode only (sk_test_...). Live keys are refused at startup.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Where Paystack sends the customer after paying (any page you control)
PAYSTACK_CALLBACK_URL=https://example.com/thanks
# Optional: domain for placeholder customer emails sent to Paystack when the customer gives none (default example.com)
# PLACEHOLDER_EMAIL_DOMAIN=example.com

# Store: "memory" (seeded from data/seed.json, resets on restart), "sheets", or "postgres" (everything kept; see docs/storage.md)
STORE=memory
# Needed for STORE=postgres, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
GOOGLE_SHEET_ID=
# Service account JSON, raw or base64. Share the sheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: forward verified payments to a Chord event subscription
CHORD_EVENT_WEBHOOK_URL=
CHORD_EVENT_SIGNING_SECRET=
# Leadaut sync: paid orders go to Leadaut's Store webhook (WooCommerce format). See docs/leadaut-sync.md.
LEADAUT_WEBHOOK_URL=
LEADAUT_WEBHOOK_SECRET=
